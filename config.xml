<?xml version='1.0' encoding='utf-8'?>
<widget id="com.shogi.imperiosdois" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>SHOGI: Guerra dos Impérios</name>
  <description>Jogo de tabuleiro estratégico Shogi - Versão Mobile</description>
  <author email="dev@shogi.com" href="https://github.com">Dev Team</author>
  <content src="index.html" />
  <plugin name="cordova-plugin-whitelist" spec="1" />
  <access origin="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <allow-intent href="tel:*" />
  <allow-intent href="sms:*" />
  <allow-intent href="mailto:*" />
  <allow-intent href="geo:*" />
  <preference name="Orientation" value="portrait" />
  <preference name="Fullscreen" value="true" />
  <preference name="StatusBarOverlaysWebView" value="true" />
  <preference name="StatusBarBackgroundColor" value="#000000" />
  <icon src="icon.png" width="192" height="192" />
  <splash src="splash.png" width="540" height="720" />
</widget>